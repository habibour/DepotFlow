# Copy to .env:  cp .env.example .env
# Everything below is a DEMO-ONLY placeholder so that `docker compose up --build` works straight away.
# For anything real, choose your own values. Never commit .env.

# SQL Server SA password (min 8 chars, upper + lower + digit + symbol).
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# Key that signs login tokens (min 32 characters).
JWT_KEY=demo-only-signing-key-change-me-0123456789abcdef

# Password of the four seeded demo users (admin, gate, yard, billing @depotflow.local).
SEED_DEFAULT_PASSWORD=Demo#DepotFlow1
